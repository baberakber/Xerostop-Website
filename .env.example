# XeroStop website environment variables
# Copy this file to .env.local and fill in the values you need.
# All variables are optional and are read at build time (static export).

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=

# Search engine ownership verification codes (content value of the meta tag only).
# Google Search Console: https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: https://www.bing.com/webmasters
NEXT_PUBLIC_BING_SITE_VERIFICATION=
